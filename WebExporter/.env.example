# The API binds to the loopback interface. Keep this a local tool.
PORT=4310
PREVIEW_PORT=4311
WEB_PORT=3000
# Optional absolute path; relative paths are resolved from the project root.
STORAGE_DIR=./storage
MAX_PAGES=30
CRAWL_DEPTH=2
PAGE_TIMEOUT=30000
# Set true only to capture trusted intranet/local sites. Default: public URLs only.
ALLOW_PRIVATE_NETWORK=false
