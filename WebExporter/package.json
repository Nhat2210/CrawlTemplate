{
  "name": "webexporter",
  "version": "1.0.0",
  "private": true,
  "description": "A local workspace for capturing, reviewing and exporting public websites.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --ignore \"storage/**\" apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/smoke.ts",
    "setup:browser": "playwright install chromium",
    "format": "prettier --write apps packages scripts tests README.md package.json tsconfig.json compose.yaml",
    "format:check": "prettier --check apps packages scripts tests README.md package.json tsconfig.json compose.yaml"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.0.0",
    "cheerio": "^1.1.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.0",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  }
}
